# PostgreSQL 账号密码。请使用 scripts/setup-env.py 生成，不要手工使用这些占位符启动。
APP_DB_PASSWORD=${APP_DB_PASSWORD}
QUERY_DB_PASSWORD=${QUERY_DB_PASSWORD}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# 宿主机直连 OrbStack PostgreSQL；容器内地址由 compose.yaml 覆盖为 db:5432。
DATABASE_URL=postgresql+psycopg://app:${APP_DB_PASSWORD}@127.0.0.1:54330/jingguan
# analyst 是只读问数账号，仅拥有 analytics schema 的 SELECT 权限。
QUERY_DATABASE_URL=postgresql+psycopg://analyst:${QUERY_DB_PASSWORD}@127.0.0.1:54330/jingguan

# 应用登录与会话安全配置。JWT_SECRET 必须使用随机长字符串。
JWT_SECRET=${JWT_SECRET}
# 首次初始化时创建 admin 账号使用；数据库已有账号后不会自动重置密码。
ADMIN_PASSWORD=${ADMIN_PASSWORD}

# 百炼 OpenAI 兼容接口，用于把自然语言解析为受约束的查询计划。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_API_KEY=

# 至少 32 字符的独立随机密钥；留空时按独立用途和用户从 JWT_SECRET 派生。
# 已保存模型后须稳定保留；更换该值（或未配置时更换 JWT_SECRET）需要迁移密文。
MODEL_ENCRYPTION_SECRET=

# pgvector 文档向量配置；API Key 留空时复用 LLM_API_KEY。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# 每次语义检索最多返回给查询规划器的业务上下文数量。
RETRIEVAL_TOP_K=12

# 百炼 Qwen-Audio 语音识别与合成。API Key 留空时复用 LLM_API_KEY。
# 若已开通业务空间专属域名，可将地址改成 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1。
AUDIO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AUDIO_API_KEY=
ASR_MODEL=qwen-audio-3.0-asr-flash
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6
AUDIO_TIMEOUT=90

# 本地 HTTP 环境使用 false；配置 HTTPS 域名后应改为 true。
COOKIE_SECURE=false
# 只允许该前端来源发起修改请求，需与实际访问地址完全一致。
# 允许访问后端的前端来源，多个地址用英文逗号分隔，不要以 / 结尾。
ALLOWED_ORIGIN=http://127.0.0.1:5178,http://127.0.0.1:5881,http://localhost:5881

# 前端容器对宿主机发布的地址和端口。本地默认值不会直接暴露到公网。
# 无域名的云服务器可设置 APP_BIND_ADDRESS=0.0.0.0、APP_PORT=80。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=5178
